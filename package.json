{
  "name": "@chris.araneo/eslint-config",
  "version": "0.0.142",
  "description": "ESLint shareable configuration",
  "keywords": [
    "eslint",
    "typescript",
    "angular",
    "nx",
    "json",
    "eslint-config",
    "eslint-rules"
  ],
  "homepage": "https://github.com/ChrisAraneo/eslint-config",
  "bugs": {
    "url": "https://github.com/ChrisAraneo/eslint-config/issues"
  },
  "license": "MIT",
  "author": "Krzysztof Pająk (Chris Araneo) <chris.araneo@gmail.com>",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "rimraf ./dist && tsc --build tsconfig.json",
    "chores": "npm run lint:fix && npm run format",
    "format": "npx sort-package-json && prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage"
  },
  "overrides": {
    "undici": "^7.30.1"
  },
  "dependencies": {
    "@chris.araneo/eslint-plugin-ng-perfectionist": "^0.0.5",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "@humanwhocodes/momoa": "^3.3.10",
    "@nx/eslint-plugin": "^23.1.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "angular-eslint": "^22.1.0",
    "app-root-dir": "^1.0.2",
    "eslint": "^10.8.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsonc": "^3.3.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-perfectionist": "^5.10.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unicorn": "^72.0.0",
    "jsonc-eslint-parser": "^3.1.0",
    "lodash-es": "^4.18.1",
    "ts-pattern": "^5.9.0",
    "typescript-eslint": "^8.65.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@types/app-root-dir": "^0.1.4",
    "@types/jest": "^30.0.0",
    "@types/lodash-es": "^4.17.12",
    "jest": "^30.4.2",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "sort-package-json": "^4.0.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
